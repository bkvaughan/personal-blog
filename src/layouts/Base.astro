---
import '@fontsource/pirata-one';
import '@fontsource/im-fell-english-sc';
import '@fontsource/alegreya/400.css';
import '@fontsource/alegreya/400-italic.css';
import '@fontsource/alegreya/700.css';
import '../styles/global.css';
import { SITE } from '../site';
import { href } from '../lib/data';

interface Props {
  title?: string;
  description?: string;
  theme?: { accent: string; mist: string; effect: string };
}

const { title, description = SITE.tagline, theme = SITE.theme } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0d0e" />
    <title>{fullTitle}</title>
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={href('rss.xml')} />
  </head>
  <body data-effect={theme.effect} style={`--accent:${theme.accent};--mist:${theme.mist}`}>
    <!-- Atmosphere layers sit behind the content; torchlight only darkens the
         backdrop, never the text, so long logs stay readable. -->
    <div class="atmo atmo-base" aria-hidden="true"></div>
    <div class="atmo atmo-fog" aria-hidden="true"><div></div><div></div></div>
    <canvas class="atmo atmo-particles" aria-hidden="true"></canvas>
    <div class="atmo atmo-torch" aria-hidden="true"></div>

    <header class="site-header">
      <a class="site-title" href={href()}>
        <svg class="flame" viewBox="0 0 24 32" aria-hidden="true">
          <path d="M12 1c1 6 8 9 8 18a8 8 0 0 1-16 0c0-5 3-7 4-11 1 3 2 4 3 4-1-4 0-8 1-11z" />
        </svg>
        {SITE.title}
      </a>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>Kept by torchlight. Independent fan chronicle; not affiliated with The Arcane Library.</p>
      <p><a href={href('rss.xml')}>RSS</a></p>
    </footer>

    <script>
      import { startAtmosphere } from '../scripts/atmosphere';
      startAtmosphere();
    </script>
  </body>
</html>
